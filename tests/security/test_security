
import sys
from pathlib import Path
from unittest.mock import Mock

import pytest
from werkzeug.security import check_password_hash, generate_password_hash

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src" / "backend"))

import app as gallery_app
import storedProcedures


@pytest.fixture
def client(monkeypatch):
    gallery_app.app.config.update(
        TESTING=True,
        SECRET_KEY="test-only-secret",
    )

    with gallery_app.app.test_client() as test_client:
        yield test_client


def login_as(client, role="Guest"):
    with client.session_transaction() as session:
        session["loggedin"] = True
        session["id"] = 1
        session["username"] = "testuser"
        session["role"] = role


def test_password_is_hashed():
    password = "Example-Password-123!"
    stored_value = generate_password_hash(password)

    assert stored_value != password
    assert check_password_hash(stored_value, password)
    assert not check_password_hash(stored_value, "Wrong-Password")


def test_sql_injection_login_input_is_treated_as_text(client, monkeypatch):
    # Use a fake database response rather than the real database.
    fake_db = Mock()
    fake_db.execute.return_value.fetchone.return_value = None
    fake_db.cursor.return_value = Mock()
    monkeypatch.setattr(gallery_app, "get_db_connection", lambda: fake_db)

    response = client.post(
        "/login",
        data={
            "username": "' OR '1'='1' --",
            "password": "anything",
        },
        follow_redirects=True,
    )

    assert b"Incorrect username or password" in response.data
    fake_db.execute.assert_called_once_with(
        "SELECT * FROM Users WHERE username = ?",
        ("' OR '1'='1' --",),
    )


def test_guest_cannot_create_user(client, monkeypatch):
    login_as(client, role="Guest")
    insert_user = Mock()
    monkeypatch.setattr(gallery_app, "insertUser", insert_user)

    response = client.post(
        "/create_user",
        data={
            "username": "newuser",
            "password": "Example-Password-123!",
            "role": "Guest",
            "name": "New User",
            "age": "20",
        },
    )

    assert response.status_code == 302
    insert_user.assert_not_called()


def test_invalid_role_is_rejected(client, monkeypatch):
    login_as(client, role="Admin")
    insert_user = Mock()
    monkeypatch.setattr(gallery_app, "insertUser", insert_user)

    response = client.post(
        "/create_user",
        data={
            "username": "newuser",
            "password": "Example-Password-123!",
            "role": "SuperAdmin",
            "name": "New User",
            "age": "20",
        },
    )

    assert response.status_code == 302
    insert_user.assert_not_called()


def test_untrusted_text_is_html_escaped(client, monkeypatch):
    login_as(client)

    monkeypatch.setattr(
        gallery_app,
        "viewAllRooms",
        lambda: [],
    )
    monkeypatch.setattr(
        gallery_app,
        "seeCurrentRoom",
        lambda user_id: "Gallery",
    )

    with client.session_transaction() as session:
        session["username"] = "<script>alert(1)</script>"

    response = client.get("/home")

    assert response.status_code == 200
    assert b"<script>alert(1)</script>" not in response.data
